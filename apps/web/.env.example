# Public config for the chat UI. Both values are safe to expose — the Turnstile
# site key is designed to appear in page source, and the Worker URL is public.
# The Turnstile *secret* belongs in the Worker: wrangler secret put TURNSTILE_SECRET_KEY

# Deployed Worker. Defaults to http://127.0.0.1:8787/chat when unset.
NEXT_PUBLIC_CHAT_API_URL=https://chat-api.arthur-ferreiramiran.workers.dev/chat

# Turnstile site key. Without it the widget does not render and no token is
# sent — which the Worker refuses in a deployed build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
