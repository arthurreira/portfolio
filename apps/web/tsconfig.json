{
  "extends": "@arthurreira/typescript-config/nextjs.json",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "@arthurreira/ui/globals.css": ["../../packages/ui/src/styles/globals.css"],
      "@arthurreira/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}