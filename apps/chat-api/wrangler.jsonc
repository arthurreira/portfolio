{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  // nodejs_compat: the AI SDK's Anthropic provider imports Node built-ins.
  // enable_request_signal: without it `request.signal` exists but never fires
  // on client disconnect, so the abort below would be wired to a dead wire.
  // It has no "default as of" date — no compatibility_date turns it on.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "observability": {
    "enabled": true,
  },
  // Fallback model, used when Anthropic is unavailable. Bills against the
  // Workers plan rather than the Anthropic balance — which matters, since the
  // balance running dry is the likeliest reason we ever reach it.
  "ai": {
    "binding": "AI",
  },
  "vars": {
    // Deployed builds must have a Turnstile secret. Without this the check
    // silently skips itself when the secret is missing, which would ship an
    // unprotected endpoint with no error to notice. Local `.dev.vars` can set
    // this to "false" to run keyless.
    "REQUIRE_TURNSTILE": "true",
  },
  "unsafe": {
    "bindings": [
      {
        // Per-IP throttle applied before any upstream call, so abuse costs
        // nothing. Counts per data centre rather than globally, which makes it
        // approximate — fine for stopping abuse, not for exact quotas.
        // `period` accepts only 10 or 60 seconds.
        "name": "CHAT_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 },
      },
    ],
  },
}
