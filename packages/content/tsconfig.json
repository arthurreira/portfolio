{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": false,
    "isolatedModules": true,
    // Scripts are run directly by Node's type stripping, which needs the real
    // file extension in the specifier.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "glossary.ts",
    "plugins/**/*.ts",
    "scripts/**/*.ts",
    "velite.config.ts",
    "src/**/*.ts"
  ],
  "exclude": ["node_modules", ".velite"]
}
